{
  "name": "discworldbr",
  "version": "1.0.0",
  "description": "Site com os livros de Terry Pratchett publicados no Brasil. Série Discworld e demais estórias.",
  "main": "index.js",
  "scripts": {
    "build": "concurrently \"npm run build:css\" \"npm run build:11ty\"",
    "build:css": "npx @tailwindcss/cli -i src/_includes/css/main.css -o src/static/css/styles.css",
    "build:11ty": "npx @11ty/eleventy",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:11ty\"",
    "dev:css": "npx @tailwindcss/cli -i src/_includes/css/main.css -o src/static/css/styles.css --watch",
    "dev:11ty": "npx @11ty/eleventy --serve"
  },
  "keywords": [],
  "author": "thigoap",
  "license": "ISC",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.0"
  }
}
